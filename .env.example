# Copy to .env (gitignored) for docker compose.
# Keycloak client "mailmerge" secret (realm: mailmerge). See SETUP.md.
MAILMERGE_CLIENT_SECRET=
# Entra (Azure AD) app for Microsoft 365 mailboxes. See SETUP.md. Leave blank to use SMTP/test accounts only.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# GitHub token with read:packages, for restoring SharedKernel.* during docker build.
GITHUB_PACKAGES_TOKEN=
